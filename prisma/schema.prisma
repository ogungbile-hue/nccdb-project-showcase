datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  CONTRIBUTOR_QS
  SUPPLIER
  SUBSCRIBER_ENTERPRISE
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  name             String
  role             UserRole      @default(CONTRIBUTOR_QS)
  isActive         Boolean       @default(true)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lastLoginAt      DateTime?

  reputationScore Int           @default(50)
  isVerifiedQs    Boolean       @default(false) 
  phoneNumber     String?       @unique

  // 🔐 Password Recovery Fields Added
  resetToken       String?       @unique
  resetTokenExpiry DateTime?

  submissions      PriceRecord[] @relation("SubmittedPrices")
  approvals        PriceRecord[] @relation("ApprovedPrices")
  supplierProfile  SupplierProfile?
  activityLogs     ActivityLog[]

  @@map("users")
}

model SupplierProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  address     String?
  isActive    Boolean  @default(true)
  materials   MaterialSupplier[]

  @@map("supplier_profiles")
}

model Location {
  id           String        @id @default(uuid())
  city         String
  zone         String
  createdAt    DateTime      @default(now())
  priceRecords PriceRecord[]

  @@unique([city, zone])
  @@map("locations")
}

model SupplierFeed {
  id            String   @id @default(uuid())
  spreadsheetId String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("supplier_feeds")
}

model MaterialCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  materials   Material[]

  @@map("material_categories")
}

model Material {
  id                String              @id @default(uuid())
  name              String
  specification     String?
  unitOfMeasurement String
  categoryId        String
  category          MaterialCategory    @relation(fields: [categoryId], references: [id])
  lastPriceUpdate   DateTime?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())

  priceRecords       PriceRecord[]
  suppliers          MaterialSupplier[]
  rateComponents     UnitRateComponent[]

  @@map("materials")
}

model MaterialSupplier {
  id          String          @id @default(uuid())
  materialId  String
  material    Material        @relation(fields: [materialId], references: [id])
  supplierId  String
  supplier    SupplierProfile @relation(fields: [supplierId], references: [id])
  isPreferred Boolean         @default(false)

  @@unique([materialId, supplierId])
  @@map("material_suppliers")
}

// 🌟 FIXED: Removed SCRAPER and WHATSAPP. Aligned strictly to core professional metrics.
enum PriceSourceType {
  QS_REPORT
  MANUAL_ENTRY
  TENDER_RETURN
  MARKET_BULLETIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  FLAGGED
  CORRUPTED
}

model PriceRecord {
  id            String          @id @default(uuid())
  materialId    String
  material      Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location        @relation(fields: [locationId], references: [id])
  
  price         Decimal?        @db.Decimal(12, 2)
  rawPriceInput String?
  currency      String          @default("NGN")
  timestamp     DateTime        @default(now())
  deviationRate Float?
  sourceType    PriceSourceType
  status        ApprovalStatus  @default(PENDING)
  notes         String?
  submittedById String?
  submittedBy   User?           @relation("SubmittedPrices", fields: [submittedById], references: [id])
  
  approvedById  String?
  approvedBy    User?           @relation("ApprovedPrices", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  deletedAt     DateTime?

  @@index([materialId, locationId, timestamp])
  @@index([status])
  @@index([sourceType])
  @@map("price_records")
}

enum ComponentType {
  MATERIAL
  LABOR
  PLANT
}

model UnitRateItem {
  id          String              @id @default(uuid())
  code        String              @unique
  description String              
  unit        String
  overheadPct Decimal             @default(15.00) @db.Decimal(5, 2)
  profitPct   Decimal             @default(10.00) @db.Decimal(5, 2)
  createdAt   DateTime            @default(now())
  components  UnitRateComponent[]

  @@map("unit_rate_items")
}

model UnitRateComponent {
  id             String        @id @default(uuid())
  unitRateItemId String
  unitRateItem   UnitRateItem  @relation(fields: [unitRateItemId], references: [id], onDelete: Cascade)
  
  type           ComponentType
  constant       Decimal       @db.Decimal(10, 4)
  
  materialId     String?       
  material       Material?     @relation(fields: [materialId], references: [id])
  
  laborPlantId   String?       
  laborPlant     LaborPlantLibrary? @relation(fields: [laborPlantId], references: [id])

  @@map("unit_rate_components")
}

model LaborPlantLibrary {
  id            String              @id @default(uuid())
  name          String              @unique 
  type          ComponentType
  baseRate      Decimal             @db.Decimal(12, 2)
  unit          String
  lastUpdated   DateTime            @updatedAt
  components    UnitRateComponent[]

  @@map("labor_plant_library")
}

model MasterMaterial {
  id           String          @id @default(uuid())
  standardName String          @unique
  materialCode String          @unique 
  category     String
  brand        String
  spec         String
  unit         String
  embedding    Float[]         // 768-dimension semantic vector
  aliases      MaterialAlias[] 
  createdAt    DateTime        @default(now())

  @@map("master_materials")
}

model MaterialAlias {
  id               String         @id @default(uuid())
  aliasName        String         @unique 
  masterMaterialId String
  masterMaterial   MasterMaterial @relation(fields: [masterMaterialId], references: [id], onDelete: Cascade)

  @@map("material_aliases")
}

enum ActivityType {
  USER_LOGIN
  USER_REGISTER
  GOOGLE_LOGIN
  ADMIN_LOGIN
}

model ActivityLog {
  id        String       @id @default(uuid())
  type      ActivityType
  message   String
  metadata  Json?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([type])
  @@map("activity_logs")
}