# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nccdb?schema=public"

# Administrative Credentials
ADMIN_USERNAME=admin@nccdb.com
ADMIN_PASSWORD=change_this_secure_password

# Cryptographic Token Signing Key
JWT_SECRET=generate_a_secure_random_256_bit_secret_here

# Frontend Google OAuth Client ID (Vite client-side access)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Sheets & Drive Integration (Sheet Sync Daemon)
MASTER_REGISTRY_SHEET_ID=your_master_registry_spreadsheet_id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google Gemini API Key (Semantic Material Reconciliation)
GEMINI_API_KEY=your_gemini_api_key

# Telegram Admin Notification Bot (Optional)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
